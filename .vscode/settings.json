{
  "console-ninja.autoCommentSource": false,
  "console-ninja.logPerformance": false,
  "console-ninja.logProtocolMessages": false,
  "console-ninja.printLogsIntoConsole": false,
  "console-ninja.showNodataPlaceholder": false,
  "console-ninja.suppressLogging": false,
  "console-ninja.autoExpandLogs": false,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.formatOnSave": true,
  "task.allowAutomaticTasks": true,
  "debug.openDebug": "neverOpen",
  "terminal.integrated.inheritEnv": false,
  "tasks": {
    "label": "lint on open",
    "type": "shell",
    "command": "npm run lint",
    "runOn": "folderOpen"
  }
}
